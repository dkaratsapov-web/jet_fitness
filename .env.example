# ─────────────────────────────────────────────────────────────
# Jet Fitness — environment template (Phase 0)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────
# From @BotFather. Required for bot + initData validation.
BOT_TOKEN=
# Public HTTPS URL where Telegram sends bot webhook updates.
# In the prod stack this is derived from API_DOMAIN automatically; set it
# manually only for custom setups. Leave empty for local long-polling.
WEBHOOK_URL=
# Optional secret token echoed by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
BOT_WEBHOOK_SECRET=
# Public HTTPS URL of the Mini App. In the prod stack this is derived from
# APP_DOMAIN automatically; set manually only for custom setups.
MINIAPP_URL=

# ── Production deployment (docker-compose.prod.yml) ──────────
# Two subdomains of YOUR domain, pointed (A/AAAA) at the VPS IP:
#   APP_DOMAIN -> Mini App    API_DOMAIN -> REST API + bot webhook
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# Email for Let's Encrypt certificate registration / expiry notices.
ACME_EMAIL=you@example.com
# Postgres password used by the prod stack (defaults to "jet" if unset).
POSTGRES_PASSWORD=change-me

# ── Database ─────────────────────────────────────────────────
# For Docker Compose the host is `postgres`; for local host use `localhost`.
DATABASE_URL=postgresql://jet:jet@localhost:5432/jet_fitness?schema=public

# ── Redis (BullMQ) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── S3 / MinIO (file storage) ────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jet-fitness
S3_KEY=minioadmin
S3_SECRET=minioadmin
# MinIO requires path-style addressing.
S3_FORCE_PATH_STYLE=true

# ── Payments ─────────────────────────────────────────────────
# Telegram Payments provider token (e.g. YooKassa via BotFather).
PAYMENT_PROVIDER_TOKEN=
# Platform commission as a percentage of each client payment.
PLATFORM_FEE_PERCENT=10

# ── Auth / security ──────────────────────────────────────────
# Max age of Telegram initData signature before it is rejected (seconds).
INITDATA_TTL_SECONDS=86400

# ── Feature flags ────────────────────────────────────────────
# Health module (labs + supplements) is OFF until legal review (see spec §10).
HEALTH_MODULE_ENABLED=false

# ── Service ports (local dev) ────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
# Comma-separated list of allowed CORS origins for the API (Mini App origin).
CORS_ORIGINS=http://localhost:5173

# ── Mini App build-time (Vite) ───────────────────────────────
# Base URL the Mini App uses to reach the API.
VITE_API_URL=http://localhost:3000
